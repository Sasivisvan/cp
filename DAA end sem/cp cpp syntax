// 6. ALGORITHMS & CUSTOM COMPARATORS
// ==========================================
// Custom comparator: Sort pairs primarily by 2nd element descending
bool customCompare(pair<int, int> a, pair<int, int> b) {
    if (a.second == b.second) return a.first < b.first; // Tie breaker
    return a.second > b.second; 
}

void learnAlgorithms() {
    cout << "--- STL Algorithms ---\n";
    vector<int> v = {4, 2, 5, 1, 3};
    
    // Sorting (O(N log N))
    sort(v.begin(), v.end()); // Ascending
    sort(v.rbegin(), v.rend()); // Descending using reverse iterators
    
    // Min/Max/Sum
    int mx = *max_element(v.begin(), v.end());
    int mn = *min_element(v.begin(), v.end());
    int sum = accumulate(v.begin(), v.end(), 0); // 0 is initial sum
    cout << "Max: " << mx << ", Min: " << mn << ", Sum: " << sum << "\n";

    // Reversing
    reverse(v.begin(), v.end());

    // Binary Search (Array MUST be sorted first) O(log N)
    sort(v.begin(), v.end()); // v is now {1, 2, 3, 4, 5}
    bool exists = binary_search(v.begin(), v.end(), 3);
    
    // Lower/Upper Bound (Very Important for HackerRank!)
    // lower_bound returns iterator to first element >= target
    auto lb = lower_bound(v.begin(), v.end(), 3); 
    // upper_bound returns iterator to first element > target
    auto ub = upper_bound(v.begin(), v.end(), 3); 
    
    cout << "Lower bound of 3 is at index: " << distance(v.begin(), lb) << "\n";
    
    // Custom Sorting Example
    vector<pair<int, int>> vec_pairs = {{1, 10}, {2, 50}, {3, 10}};
    sort(vec_pairs.begin(), vec_pairs.end(), customCompare);
    cout << "Custom sorted pairs: ";
    for(auto p : vec_pairs) cout << "{" << p.first << "," << p.second << "} ";
    cout << "\n\n";
}

