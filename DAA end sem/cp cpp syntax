void learnMathAndBits() {
    cout << "--- Math & Bit Manipulation ---\n";
    // Standard Math
    cout << "Power (2^3): " << pow(2, 3) << "\n";
    cout << "Square root (16): " << sqrt(16) << "\n";
    
    // GCD and LCM (Requires C++17)
    cout << "GCD(12, 18): " << gcd(12, 18) << "\n";
    cout << "LCM(12, 18): " << lcm(12, 18) << "\n";

    // Bit Manipulation
    int n = 29; // Binary: 11101
    cout << "Number of 1-bits in 29: " << __builtin_popcount(n) << "\n";
    cout << "Is 16 a power of 2? " << ((16 & (16 - 1)) == 0 ? "Yes" : "No") << "\n\n";
}

